# Postgres (from Vercel / Neon / Prisma — paste all three from the host)
POSTGRES_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
PRISMA_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# App secrets (generate your own; never commit real values)
ENCRYPTION_KEY="change-me-to-a-long-random-secret-key"
SESSION_SECRET="complex_password_at_least_32_characters_long_change_me"
CRON_SECRET="change-me-cron-secret"
